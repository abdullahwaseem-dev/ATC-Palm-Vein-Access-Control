#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Built APKs
/release/*.apk

# ---- Never publish -------------------------------------------------------
# Release signing secrets
android/key.properties
android/*.jks
*.jks
*.keystore
# Built installers (contain proprietary vendor binaries)
/release/
*.apk
*.aab
# Proprietary vendor SDK binaries (HFSecurity VP530, eyecool UVC, Hibory board API).
# Obtain from the hardware vendor; see android/app/libs/README.md
android/app/libs/**/*.aar
android/app/libs/**/*.jar
android/app/src/rk/jniLibs/
android/app/src/mtk/jniLibs/
# Dart split-debug symbols
/build/symbols/

# Golden-test failure diffs
test/failures/
